{
  "name": "@deepseek-ai/code-intel",
  "version": "0.1.0",
  "description": "DeepSeek Harness code-intel plugin: IDE-like code intelligence for coding agents, providing semantic code retrieval, editing, refactoring and debugging capabilities",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "resources/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node tools/assert-package-files.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/code-intel.git",
    "directory": "packages/code-intel"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-intel",
    "code-intelligence",
    "symbol-search",
    "symbol-navigation",
    "refactoring",
    "memory-management",
    "diagnostics"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "typescript": ">=5.0.0"
  }
}