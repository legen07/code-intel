{
  "name": "@deepseek-ai/code-intel",
  "version": "0.2.0",
  "description": "Code intelligence for DeepSeek Harness agents: LSP-backed symbol discovery, a persisted project blueprint graph, and Serena-style semantic retrieval tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "link-peers": "node tools/link-peers.mjs",
    "build": "node build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/",
    "prepack": "node tools/assert-package-files.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/code-intel.git",
    "directory": "packages/code-intel"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-intel",
    "code-intelligence",
    "symbol-search",
    "symbol-navigation",
    "codegraph",
    "lsp"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "dependencies": {
    "typescript": "~5.9.0",
    "typescript-language-server": "^6.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
