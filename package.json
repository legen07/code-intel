{
  "name": "code-intel",
  "version": "0.2.0",
  "description": "Code intelligence for DeepSeek Harness agents: LSP-backed symbol discovery, a persisted project blueprint graph, and Serena-style semantic retrieval tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "link-peers": "node tools/link-peers.mjs",
    "build": "node build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/",
    "prepack": "node tools/assert-package-files.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legen07/code-intel.git"
  },
  "homepage": "https://github.com/legen07/code-intel#readme",
  "bugs": {
    "url": "https://github.com/legen07/code-intel/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-intel",
    "code-intelligence",
    "symbol-search",
    "symbol-navigation",
    "codegraph",
    "lsp"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1",
      "profiles": [
        "web"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "LSP-backed code intelligence for DeepSeek Harness agents: symbol search, references, a persisted project blueprint graph, and a symbol-browser sidebar.",
        "zh": "为 DeepSeek Harness 智能体提供 LSP 支撑的代码智能：符号搜索、引用查找、持久化项目蓝图图谱与符号浏览器侧栏。"
      },
      "capabilities": [
        "tools",
        "sidebar",
        "remote",
        "subprocess",
        "filesystem"
      ]
    }
  },
  "dependencies": {
    "typescript": "~5.9.0",
    "typescript-language-server": "^6.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
