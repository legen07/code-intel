# Editor configuration — keeps every contributor's editor honest.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}]
indent_size = 2

[*.md]
# Trailing two spaces = hard line break in Markdown; keep them if present.
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab
